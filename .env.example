# 复制为 .env 后填写。Compose 会覆盖容器内的 DATABASE_URL / REDIS_URL。

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIM=1024
# 嵌入、重排可以单独指定地址和密钥；留空则沿用上面的 SILICONFLOW_BASE_URL / SILICONFLOW_API_KEY
SILICONFLOW_EMBEDDING_API_KEY=
SILICONFLOW_EMBEDDING_BASE_URL=
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_RERANKER_API_KEY=
SILICONFLOW_RERANKER_BASE_URL=
LLM_TIMEOUT_SEC=90
LLM_MAX_RETRIES=3
EMBEDDING_MAX_CONCURRENCY=5

# 本机直接跑 Python 时使用；docker compose 会改成 db / redis 主机名
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5433/drugintel
REDIS_URL=redis://127.0.0.1:6379/0

# 告警邮件，不用可留空
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
